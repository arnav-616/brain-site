{
  "name": "brain-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "export:public": "node scripts/export-vault.js --mode public && node scripts/og-cards.js",
    "export:private": "node scripts/export-vault.js --mode private",
    "dev:private": "npm run export:private && VITE_GRAPH=private vite",
    "test": "vitest run",
    "notifications:install": "node scripts/install-notifications.js",
    "notifications:remove": "node scripts/install-notifications.js --remove",
    "dev:phone": "npm run export:private && VITE_GRAPH=private vite --host --port 5180 --strictPort",
    "phone:link": "node scripts/phone-link.js",
    "create-vault": "node scripts/create-vault.js",
    "test:ui": "node scripts/ui-check.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.19.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-force-graph-3d": "^1.29.2",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "axe-core": "^4.10.2",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "puppeteer-core": "^23.11.1",
    "tailwindcss": "^4.3.3",
    "vite": "^6.3.5",
    "vitest": "^5.0.4"
  }
}
